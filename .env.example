# ApplyFlow Environment Configurations
# Store your portal login credentials here to enable automated 1-click AI sign-in.
# (This file is ignored by Git to keep your credentials strictly local and private).

# LinkedIn Credentials for automated AI login
LINKEDIN_EMAIL=your_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password

# Indeed Credentials for automated AI login
INDEED_EMAIL=your_email@example.com
INDEED_PASSWORD=your_indeed_password

# Browser & UI Settings (Optional)
HEADLESS=false
SLOW_MO_MS=150
BROWSER_TIMEOUT_MS=30000

# Local Ollama Configurations (Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llama3.2-vision:latest
