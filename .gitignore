# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
venv/
env/
ENV/

# Environment variables & secrets
.env
.env.*
!.env.example

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/
test-results/
playwright-report/

# Logs
*.log

# Runtime application data & captures
data/applications.sqlite
data/browser_profile/
data/screenshots/*
!data/screenshots/.gitkeep
data/*.html
data/*.dump

